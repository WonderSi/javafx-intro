<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<GridPane prefHeight="150.0" prefWidth="499.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.javafxintro.calculator.CalculatorController">
    <padding>
        <Insets bottom="10" left="10" right="10" top="10" />
    </padding>
    <children>
        <TextField fx:id="number1" promptText="Введите число 1" />
        <TextField fx:id="number2" prefWidth="174.0" promptText="Введите число 2" GridPane.columnIndex="4" />
        <Label fx:id="resultLabel" prefHeight="18.0" prefWidth="180.0" text="Результат:" GridPane.columnSpan="2" GridPane.rowIndex="3" />
        <Button onAction="#handleAdd" prefHeight="26.0" prefWidth="73.0" text="Сложить" GridPane.columnIndex="6" />
        <Button onAction="#handleMultiply" prefHeight="26.0" prefWidth="73.0" text="Умножить" GridPane.columnIndex="6" GridPane.rowIndex="5" />
        <Button onAction="#handleDivide" prefHeight="26.0" prefWidth="73.0" text="Разделить" GridPane.columnIndex="6" GridPane.rowIndex="6" />
        <Button onAction="#handleSubtract" prefHeight="26.0" prefWidth="73.0" text="Вычесть" GridPane.columnIndex="6" GridPane.rowIndex="3" />
    </children>
   <columnConstraints>
      <ColumnConstraints maxWidth="180.0" minWidth="180.0" prefWidth="150.0" />
      <ColumnConstraints maxWidth="45" minWidth="0.0" prefWidth="20.0" />
      <ColumnConstraints maxWidth="28" minWidth="0.0" prefWidth="0.0" />
      <ColumnConstraints maxWidth="33" minWidth="0.0" prefWidth="0.0" />
      <ColumnConstraints maxWidth="180.0" minWidth="180" prefWidth="180" />
      <ColumnConstraints maxWidth="40" minWidth="0.0" prefWidth="21" />
      <ColumnConstraints maxWidth="104" minWidth="16" prefWidth="72" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints prefHeight="32.0" />
      <RowConstraints />
      <RowConstraints />
      <RowConstraints prefHeight="32.0" />
      <RowConstraints maxHeight="10" minHeight="0.0" prefHeight="0.0" />
      <RowConstraints maxHeight="48" minHeight="15" prefHeight="32.0" />
      <RowConstraints maxHeight="48" minHeight="0.0" prefHeight="32.0" />
   </rowConstraints>
</GridPane>
